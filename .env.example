# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# --- Mapbox ---
# Public token (pk....) used by the app at runtime to render the map.
MAPBOX_ACCESS_TOKEN=
# Secret download token (sk....) with the DOWNLOADS:READ scope, used only at
# build time to fetch the native Mapbox SDK. Create it in the Mapbox dashboard.
MAPBOX_DOWNLOAD_TOKEN=

# --- UT EID / UT SSO (OIDC) ---
# Client provisioned by UT IAM. It is a CONFIDENTIAL client: UT's OP does not
# support token_endpoint_auth_method "none", so the code exchange is client-
# authenticated and runs through our token broker (server/), never on-device.
#
# The client SECRET must never appear in this file. app.config.js serialises
# process.env into the app bundle, so anything here ships to every install.
# The secret belongs only in the broker's own environment:
#   npx wrangler secret put UT_OAUTH_CLIENT_SECRET
#
# Endpoints match UT's published discovery document
# (https://enterprise.login.utexas.edu/.well-known/openid-configuration) and are
# hardcoded as defaults in app.config.js — only set them here to override.
# Set UT_OAUTH_ENABLED=true to use real SSO; false uses a local mock session.
UT_OAUTH_ENABLED=false
UT_OAUTH_CLIENT_ID=cola-class-finder-oidc
UT_OAUTH_ISSUER=https://enterprise.login.utexas.edu
UT_OAUTH_AUTHORIZATION_ENDPOINT=https://enterprise.login.utexas.edu/idp/profile/oidc/authorize
UT_OAUTH_TOKEN_ENDPOINT=https://enterprise.login.utexas.edu/idp/profile/oidc/token
UT_OAUTH_USERINFO_ENDPOINT=https://enterprise.login.utexas.edu/idp/profile/oidc/userinfo
UT_OAUTH_SCOPES=openid profile utexas_profile
# Base URL of the deployed token broker. Required when UT_OAUTH_ENABLED=true.
# Local dev against `node server/token-broker.mjs` needs your machine's LAN IP,
# not localhost — the phone resolves localhost to itself.
UT_OAUTH_BROKER_URL=

# --- Debug tooling (optional; leave unset for App Store builds) ---
# Simulated navigation origin, "lng,lat". Seeds the walking-route origin for the
# whole session so directions can be tested from off campus.
# DEBUG_ORIGIN=-97.7335,30.2849
# Enables the hidden long-press-the-logo toggle that sets a campus origin at
# runtime, plus the "SIMULATED ORIGIN" badge. Dev builds always have it.
# Set this for TestFlight builds; unset it before submitting to the App Store.
# DEBUG_TOOLS=true
